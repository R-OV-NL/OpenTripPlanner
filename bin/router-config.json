{
  "routingDefaults": {
    "maxJourneyDuration": "PT12H",
    "numItineraries": 6,
    "waitReluctance": 0.5,
    "transferSlack": 0,
    "bicycle": {
      "rental": {
        "allowKeepingAtDestination": true,
        "dropOffTime": "PT1M",
        "useAvailabilityInformation": true
      }
    },
    "walk": {
      "speed": 1.4,
      "stairsReluctance": 1.4
    },
    "car": {
      "pickupTime": "PT4M"
    }
  },
  "transit": {
    "transferCacheMaxSize": 100
  },
  "updaters": [
    {
      "feedId": "NL",
      "type": "stop-time-updater",
      "frequency": "PT30S",
      "url": "https://gtfs-rt.r-ov.nl/trainUpdates.pb",
      "backwardsDelayPropagationType": "ALWAYS"
    }
